{
  "subjectCode": "FER202",
  "metadata": {
    "title": "React - Đăng ký và đăng nhập",
    "projectType": "frontend"
  },
  "testSuites": {
    "browser": [
      {
        "id": "TC01",
        "name": "Hiển thị trang đăng nhập",
        "startUrl": "/#login",
        "steps": [
          {
            "action": "assertVisible",
            "target": "[data-testid=login-page]"
          },
          {
            "action": "assertVisible",
            "target": "label[for=login-email]"
          },
          {
            "action": "assertVisible",
            "target": "label[for=login-password]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=login-submit]"
          }
        ]
      },
      {
        "id": "TC02",
        "name": "Đăng ký thiếu họ tên",
        "startUrl": "/#register",
        "steps": [
          {
            "action": "click",
            "target": "[data-testid=register-submit]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=register-error]:has-text(\"Họ tên\")"
          }
        ]
      },
      {
        "id": "TC03",
        "name": "Email đăng ký sai định dạng",
        "startUrl": "/#register",
        "steps": [
          {
            "action": "fill",
            "target": "[data-testid=register-name]",
            "value": "Nguyễn Văn A"
          },
          {
            "action": "fill",
            "target": "[data-testid=register-email]",
            "value": "not-an-email"
          },
          {
            "action": "fill",
            "target": "[data-testid=register-password]",
            "value": "DemoPass123"
          },
          {
            "action": "fill",
            "target": "[data-testid=register-confirm]",
            "value": "DemoPass123"
          },
          {
            "action": "click",
            "target": "[data-testid=register-submit]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=register-error]:has-text(\"Email không hợp lệ\")"
          }
        ]
      },
      {
        "id": "TC04",
        "name": "Mật khẩu đăng ký quá ngắn",
        "startUrl": "/#register",

            "target": "[data-testid=dashboard-page]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=profile-email]:has-text(\"student1@demo.test\")"
          }
        ]
      },
      {
        "id": "TC12",
        "name": "Đăng xuất trở lại trang đăng nhập",
        "startUrl": "/#dashboard",
        "steps": [
          {
            "action": "click",
            "target": "[data-testid=logout]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=login-page]"
          }
        ]
      },
      {
        "id": "TC13",
        "name": "Chặn truy cập trang cá nhân khi chưa đăng nhập",

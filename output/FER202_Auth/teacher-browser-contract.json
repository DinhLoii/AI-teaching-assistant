      {
        "id": "TC10",
        "name": "Đăng nhập đúng và hiển thị hồ sơ",
        "startUrl": "/#login",
        "steps": [
          {
            "action": "fill",
            "target": "[data-testid=login-email]",
            "value": "STUDENT1@DEMO.TEST"
          },
          {
            "action": "fill",
            "target": "[data-testid=login-password]",
            "value": "DemoPass123"
          },
          {
            "action": "click",
            "target": "[data-testid=login-submit]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=dashboard-page]"

            "value": "123"
          },
          {
            "action": "fill",
            "target": "[data-testid=register-confirm]",
            "value": "123"
          },
          {
            "action": "click",
            "target": "[data-testid=register-submit]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=register-error]:has-text(\"Mật khẩu phải\")"
          }
        ]
      },
      {
        "id": "TC05",
        "name": "Xác nhận mật khẩu không khớp",

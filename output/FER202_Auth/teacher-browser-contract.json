          {
            "action": "click",
            "target": "[data-testid=register-submit]"
          },
          {
            "action": "assertVisible",
            "target": "[data-testid=register-error]:has-text(\"Xác nhận mật khẩu không khớp\")"
          }
        ]
      },
      {
        "id": "TC06",
        "name": "Đăng ký thành công",
        "startUrl": "/#register",
        "steps": [
          {
            "action": "fill",
            "target": "[data-testid=register-name]",
            "value": "Nguyễn Văn A"
          },
          {
            "action": "fill",
            "target": "[data-testid=register-email]",
            "value": "student1@demo.test"
          },
          {
            "action": "fill",
            "target": "[data-testid=register-password]",
            "value": "DemoPass123"
          },
          {
            "action": "fill",

# Docker Compose configuration. Use independent random production secrets.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://aita:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/aita?schema=public
DIRECT_URL=postgresql://aita:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/aita?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://your-domain.example
SANDBOX_ENABLED=false
# Optional: a dedicated, authenticated Docker daemon on an isolated worker network.
DOCKER_HOST=
